#!/usr/bin/env bash

if ! command -v mise > /dev/null 2>&1; then
  return
fi

# Deliberately named to be sourced last by `source_all`: `mise activate bash`
# runs its hook immediately and sets __MISE_BASH_SKIP_FIRST_PROMPT=1, so the
# PROMPT_COMMAND hook does NOT re-apply the env at the first prompt. Anything
# sourced afterwards that prepends to PATH (sources/node prepending `n`'s
# ${N_PREFIX}/node/bin) would stay in front until the first `cd`.
#
# Two things are intentionally NOT done here:
#   - the shims directory (~/.local/share/mise/shims) is never added to PATH:
#     it would shadow the node managed by `n` everywhere;
#   - idiomatic_version_file_enable_tools is left alone (mise defaults to not
#     reading .nvmrc & co): enabling it globally would make mise hijack node in
#     every repo containing a .nvmrc and collide with `n`. Opt in per project.
eval "$(mise activate bash)"
