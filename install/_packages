#!/usr/bin/env bash

set -o nounset -o pipefail -o errexit

script_dir() {
  local FILE_SOURCE="${BASH_SOURCE[0]}"

  if [[ -L ${FILE_SOURCE} ]]; then
    dirname "$(readlink "${FILE_SOURCE}")"
  else
    (
      cd "$(dirname "${FILE_SOURCE}")" && pwd
    )
  fi
}

install() {
  local PACKAGES=('bash' 'bash-completion@2' 'make' 'htop' 'openssl' 'curl' 'ncdu' 'jq' 'yq' 'eza' 'bat' 'fd' 'zoxide' 'shellcheck')
  local PACKAGES_DESKTOP=('rectangle' 'google-chrome' 'raycast' 'zed' 'appcleaner' 'slack' 'notion' 'figma')

  if [[ ${OSTYPE} =~ ^darwin ]]; then
    cat >"${HOME}/.bash_profile" <<END_OF_BASH_PROFILE
#!/usr/bin/env bash
if [[ -f "${HOME}/.bashrc" ]]; then
  source "${HOME}/.bashrc"
fi
END_OF_BASH_PROFILE

    if ! command -v brew >/dev/null 2>&1; then
      /bin/bash -c "$(curl --disable --silent --show-error --location "https://raw.githubusercontent.com/Homebrew/install/master/install.sh")"
      source "$(script_dir)/../sources/_04_homebrew"
    fi

    packages_update
    packages_install "${PACKAGES[@]}" fswatch awk mole
    packages_install_desktop "${PACKAGES_DESKTOP[@]}"

    # Registration in /etc/shells and the user's shell are two independent
    # conditions: testing them together skipped the switch whenever the entry
    # already existed.
    local TARGET_SHELL CURRENT_SHELL
    TARGET_SHELL="$(brew --prefix)/bin/bash"

    if ! grep --quiet --line-regexp --fixed-strings "${TARGET_SHELL}" "/etc/shells"; then
      printf "+----------------------------------+\n"
      printf "| registering shell in /etc/shells |\n"
      printf "+----------------------------------+\n"

      echo "${TARGET_SHELL}" | sudo tee -a "/etc/shells" >/dev/null
    fi

    CURRENT_SHELL="$(dscl . -read "/Users/$(whoami)" UserShell | awk '{print $2}')"

    if [[ "${CURRENT_SHELL}" != "${TARGET_SHELL}" ]]; then
      printf "+-------------------------+\n"
      printf "| changing shell for user |\n"
      printf "+-------------------------+\n"

      # sudo dscl instead of chsh: no password prompt
      sudo dscl . -change "/Users/$(whoami)" UserShell "${CURRENT_SHELL}" "${TARGET_SHELL}"
    fi
  elif command -v apt-get >/dev/null 2>&1; then
    packages_update
    packages_install "apt-transport-https"
    packages_install "${PACKAGES[@]}" dnsutils jdupes
  elif command -v pacman >/dev/null 2>&1; then
    packages_update
    packages_install "${PACKAGES[@]}" inetutils tcpdump
  fi
}
