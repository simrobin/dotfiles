#!/usr/bin/env bash

set -o nounset -o pipefail -o errexit

script_dir() {
  local FILE_SOURCE="${BASH_SOURCE[0]}"

  if [[ -L ${FILE_SOURCE} ]]; then
    dirname "$(readlink "${FILE_SOURCE}")"
  else
    (
      cd "$(dirname "${FILE_SOURCE}")" && pwd
    )
  fi
}

clean() {
  # Destroying the VM discards every container, volume and image, so it stays
  # opt-in. ${HOME}/.docker is user state (config.json, contexts) and is never
  # removed: only the cli-plugins symlinks, which install() puts back.
  if [[ ${DOTFILES_PURGE:-} == "true" ]]; then
    if command -v colima >/dev/null 2>&1; then
      colima delete --force
    fi

    if command -v orbctl >/dev/null 2>&1; then
      orbctl reset -y
    fi
  fi

  rm -rf "${HOME}/.docker/cli-plugins"
  sudo rm -rf "${HOME}/.lima" "${HOME}/.colima"
}

install() {
  local RUNTIME="${DOTFILES_DOCKER_RUNTIME:-orbstack}"
  local SCRIPT_DIR
  SCRIPT_DIR="$(script_dir)"

  if [[ ${OSTYPE} =~ ^darwin ]]; then
    mkdir -p "${SCRIPT_DIR}/../sources/completions"

    case "${RUNTIME}" in
    colima)
      packages_install "colima"
      colima completion bash >"${SCRIPT_DIR}/../sources/completions/colima-completion"
      # OrbStack ships its own docker CLI, colima needs the nerdctl shim
      colima nerdctl install --path "${HOME}/opt/bin/docker" --force
      ;;
    orbstack)
      packages_install_desktop "orbstack"

      # OrbStack only links its plugins on first app launch, so compose and
      # buildx are missing between clean and that launch: link them here.
      mkdir -p "${HOME}/.docker/cli-plugins"
      for plugin in docker-compose docker-buildx; do
        local PLUGIN_TARGET="/Applications/OrbStack.app/Contents/MacOS/xbin/${plugin}"

        if [[ ! -x ${PLUGIN_TARGET} ]]; then
          # A return here aborts the whole ./init run, which is set -e
          var_warning "missing OrbStack plugin ${PLUGIN_TARGET}, skipping"
          continue
        fi

        ln -sf "${PLUGIN_TARGET}" "${HOME}/.docker/cli-plugins/${plugin}"
      done

      if command -v orbctl >/dev/null 2>&1; then
        orbctl completion bash >"${SCRIPT_DIR}/../sources/completions/orbctl-completion"
      fi
      ;;
    *)
      var_error "unknown DOTFILES_DOCKER_RUNTIME '${RUNTIME}', expected colima or orbstack"
      return 1
      ;;
    esac
  fi

  packages_install ctop
}
